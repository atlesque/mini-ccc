---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import BuildArt from '../../components/BuildArt.astro';
import { projects } from '../../data/projects';
import { ArrowLeft, ExternalLink } from '@lucide/astro';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
if (!project) return Astro.redirect('/');
---
<BaseLayout title={`${project.name} — build details`} description={project.summary}>
  <div class="page-shell page-shell--detail">
    <Header
      title={project.name}
      variant="detail"
    >
      <div slot="actions" class="detail-actions">
        <FavoriteButton projectId={project.slug} projectName={project.name} />
      </div>
      <div slot="media" class="detail-art">
        <BuildArt project={project} variant="detail" />
      </div>
    </Header>
    <main class="detail-page">
      <section class="detail-content section-pad">
        <div class="detail-intro">
          <p class="detail-description">{project.description}</p>
        </div>

        <div class="bom-layout">
          <div class="bom-heading">
            <h2>Parts list</h2>
          </div>
          <div class="bom-card">
            <div class="bom-card__header"><span>ITEM</span><span>COST</span></div>
            <div class="bom-rows">
              {project.items.map((item) => (
                <div class="bom-row">
                  <div><span class="bom-index">{String(item.number).padStart(2, '0')}</span><span>{item.name}</span></div>
                  <div><strong>€{item.cost.toFixed(2)}</strong><a href={item.url} target="_blank" rel="noreferrer" aria-label={`Buy ${item.name}`}><ExternalLink size={14} stroke-width={1.7} aria-hidden="true" focusable="false" /></a></div>
                </div>
              ))}
            </div>
            <div class="bom-total"><span>ESTIMATED BUILD TOTAL</span><strong>€{project.total.toFixed(2)}</strong></div>
          </div>
        </div>
      </section>

      <section class="detail-next section-pad">
        <div><h2>Find the next<br /><em>rabbit hole.</em></h2></div>
        <a class="button button--primary" href="/builds">Back to all builds <ArrowLeft size={15} stroke-width={1.7} aria-hidden="true" focusable="false" /></a>
      </section>
    </main>
  </div>
</BaseLayout>
