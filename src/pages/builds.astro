---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BrandMark from '../components/BrandMark.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectViz from '../components/ProjectViz.astro';
import { projects } from '../data/projects';

const orderedProjects = [...projects].sort((a, b) => b.votes - a.votes);
---
<BaseLayout title="Builds" description="A catalogue of tiny electronics builds for Mini CCC.">
  <div class="page-shell">
    <Header title="The build list" />
    <main>
      <section class="builds-section section-pad" id="builds">
        <div class="catalog-controls">
          <label class="search-field"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search the catalogue" aria-label="Search the catalogue" data-project-search /></label>
          <div class="filter-group" role="group" aria-label="Filter projects">
            <button type="button" class="filter-button is-active" data-filter-button data-filter="all">All builds</button><button type="button" class="filter-button" data-filter-button data-filter="play">Play</button><button type="button" class="filter-button" data-filter-button data-filter="glow">Glow</button><button type="button" class="filter-button" data-filter-button data-filter="signal">Signal</button><button type="button" class="filter-button" data-filter-button data-filter="sound">Sound</button><button type="button" class="filter-button" data-filter-button data-filter="sensor">Sensors</button><button type="button" class="filter-button filter-button--saved" data-filter-button data-filter="favorites">♡ Favorites</button>
          </div>
          <span class="catalog-count" data-project-count>{projects.length} builds</span>
        </div>
        <div class="project-grid" data-project-grid>{orderedProjects.map((project) => <ProjectCard project={project} />)}</div>
        <div class="favorite-export" data-favorite-export-panel hidden><button class="button favorite-export__button" type="button" data-favorite-export disabled>Export favorite titles <span aria-hidden="true">↓</span></button></div>
        <div class="projects-empty" data-projects-empty hidden><ProjectViz visual="radar" accent="lime" /><h3>No builds on this frequency.</h3><p>Try another search, or favorite a few builds to start your shortlist.</p></div>
      </section>
      <footer class="site-footer section-pad"><div class="footer-brand"><BrandMark /><span>mini <strong>CCC</strong></span></div></footer>
    </main>
  </div>
</BaseLayout>
