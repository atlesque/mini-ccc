---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BrandMark from '../components/BrandMark.astro';
import CuratedCard from '../components/CuratedCard.astro';
import { videos } from '../data/content';
---
<BaseLayout title="Videos" description="A shared YouTube watch list for Mini CCC.">
  <div class="page-shell"><Header title="Queue up" titleAccent="the good stuff." /><main><section class="content-section section-pad"><div class="content-grid">{videos.map((item) => <CuratedCard item={item} type="video" />)}</div></section><footer class="site-footer section-pad"><div class="footer-brand"><BrandMark /><span>mini <strong>CCC</strong></span></div></footer></main></div>
</BaseLayout>
