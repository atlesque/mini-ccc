---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectViz from '../components/ProjectViz.astro';
import { eventImage, projects, totalBudget } from '../data/projects';
---
<BaseLayout description="Mini CCC is a tiny home hacker conference for friends, prototypes, and wonderfully unnecessary electronics.">
  <div class="page-shell">
    <Header />

    <main>
      <section class="hero section-pad">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-marker">//</span> a miniature hacker conference <span class="eyebrow-rule"></span> 2026</p>
          <h1>Build something <em>tiny.</em><br /><span>Make it matter.</span></h1>
          <p class="hero-intro">Mini CCC is a living shortlist of curious little builds for one very un-virtual evening with friends. Pick a project, bring the parts, make the room glow.</p>
          <div class="hero-actions">
            <a class="button button--primary" href="#builds">Explore the builds <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="#how-it-works">What is Mini CCC? <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-stamp"><span class="stamp-line"></span><span>20 builds / 83 parts / 1 living room</span></div>
        </div>
        <div class="hero-art-wrap">
          <div class="hero-art-frame">
            <img src={eventImage} alt="Illustrated workbench with glowing electronics and a tiny receipt printer" />
            <div class="hero-art-label"><span>FIELD NOTE 001</span><strong>THE WORKBENCH<br />IS THE VENUE</strong></div>
          </div>
          <span class="hero-coordinate">50°50' N / 4°21' E</span>
          <span class="hero-art-caption">an evening of small machines<br />and questionable ideas</span>
        </div>
      </section>

      <section class="signal-strip" aria-label="Event stats">
        <div><span class="signal-label">BUILDS TO PICK</span><strong>20</strong></div>
        <div><span class="signal-label">PARTS IN THE BOM</span><strong>83</strong></div>
        <div><span class="signal-label">CATALOGUE BUDGET</span><strong>€{totalBudget.toFixed(2)}</strong></div>
        <div><span class="signal-label">CURRENT MODE</span><strong class="signal-live"><i></i> OPEN</strong></div>
      </section>

      <section class="builds-section section-pad" id="builds">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span class="eyebrow-marker">01</span> choose your rabbit hole</p>
            <h2>The build list</h2>
          </div>
          <p class="section-note">Save the ones you want to talk about.<br />Your shortlist rises to the top.</p>
        </div>

        <div class="catalog-controls">
          <label class="search-field">
            <span aria-hidden="true">⌕</span>
            <input type="search" placeholder="Search the catalogue" aria-label="Search the catalogue" data-project-search />
          </label>
          <div class="filter-group" role="group" aria-label="Filter projects">
            <button type="button" class="filter-button is-active" data-filter-button data-filter="all">All builds</button>
            <button type="button" class="filter-button" data-filter-button data-filter="play">Play</button>
            <button type="button" class="filter-button" data-filter-button data-filter="glow">Glow</button>
            <button type="button" class="filter-button" data-filter-button data-filter="signal">Signal</button>
            <button type="button" class="filter-button" data-filter-button data-filter="sound">Sound</button>
            <button type="button" class="filter-button" data-filter-button data-filter="sensor">Sensors</button>
            <button type="button" class="filter-button filter-button--saved" data-filter-button data-filter="favorites">♡ Saved</button>
          </div>
          <span class="catalog-count" data-project-count>{projects.length} builds</span>
        </div>

        <div class="project-grid" data-project-grid>
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
        <div class="projects-empty" data-projects-empty hidden>
          <ProjectViz visual="radar" accent="lime" />
          <h3>No builds on this frequency.</h3>
          <p>Try another search, or save a few builds to start your shortlist.</p>
        </div>
      </section>

      <section class="how-section section-pad" id="how-it-works">
        <div class="how-heading">
          <p class="eyebrow"><span class="eyebrow-marker">02</span> the house rules</p>
          <h2>Small enough<br /><em>to finish.</em></h2>
        </div>
        <div class="how-copy">
          <p class="large-copy">A miniature CCC is not a conference venue. It is a table, a pile of components, and enough friends to make the first working prototype feel like a headline.</p>
          <div class="rule-list">
            <div><span>01</span><p>Vote for the build you actually want to make.</p></div>
            <div><span>02</span><p>Save a few rabbit holes. We’ll decide what fits the evening.</p></div>
            <div><span>03</span><p>Leave with something blinking, beeping, or at least explainable.</p></div>
          </div>
        </div>
      </section>

      <footer class="site-footer section-pad">
        <div class="footer-brand"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>mini <strong>CCC</strong></span></div>
        <p>made for the in-between hours<br />by people who bring too many cables</p>
        <span class="footer-code">MCCC / 001</span>
      </footer>
    </main>
  </div>
</BaseLayout>
