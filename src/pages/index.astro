---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BrandMark from '../components/BrandMark.astro';

const destinations = [
  {
    href: '/schedule',
    index: '01',
    label: 'Plan the day',
    title: 'Schedule',
    description: 'Shape a loose agenda from 10:00 to 22:00.',
    accent: 'lime',
  },
  {
    href: '/builds',
    index: '02',
    label: 'Make something',
    title: 'Builds',
    description: 'Tiny electronics projects with big enough ideas.',
    accent: 'blue',
  },
  {
    href: '/cocktails',
    index: '03',
    label: 'Take a break',
    title: 'Cocktails',
    description: 'Club-Mate serves for staying bright and curious.',
    accent: 'orange',
  },
  {
    href: '/videos',
    index: '04',
    label: 'Watch together',
    title: 'Videos',
    description: 'A short list of rabbit holes worth sharing.',
    accent: 'pink',
  },
];
---
<BaseLayout title="Mini CCC" description="A tiny home conference for making, watching, mixing, and moving at your own pace.">
  <div class="page-shell">
    <Header
      title="mini CCC"
      variant="home"
    />
    <main>
      <section class="home-section section-pad">
        <div class="home-destinations" aria-label="Mini CCC sections">
          {destinations.map((destination) => (
            <a class:list={['home-card', `accent-${destination.accent}`]} href={destination.href}>
              <span class="home-card__index">{destination.index}</span>
              <span class="home-card__body">
                <span class="home-card__label">{destination.label}</span>
                <strong>{destination.title}</strong>
                <span class="home-card__description">{destination.description}</span>
              </span>
              <span class="home-card__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
      <footer class="site-footer section-pad"><div class="footer-brand"><BrandMark /><span>mini <strong>CCC</strong></span></div><span class="footer-note">Make a day of it.</span></footer>
    </main>
  </div>
</BaseLayout>
