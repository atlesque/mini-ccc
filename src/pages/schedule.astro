---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { Download } from '@lucide/astro';

const activityTypes = [
  { label: 'Cocktail making', accent: 'orange' },
  { label: 'YouTube videos', accent: 'blue' },
  { label: 'Lock picking', accent: 'pink' },
  { label: 'DIY project 1', accent: 'lime' },
  { label: 'DIY project 2', accent: 'lime' },
  { label: 'Lunch', accent: 'orange' },
  { label: 'Dinner', accent: 'orange' },
];

const defaultBlocks = [
  { ...activityTypes[0], start: 0, duration: 2 },
  { ...activityTypes[1], start: 2, duration: 2 },
  { ...activityTypes[5], start: 4, duration: 2 },
  { ...activityTypes[3], start: 6, duration: 8 },
  { ...activityTypes[2], start: 14, duration: 2 },
  { ...activityTypes[6], start: 16, duration: 2 },
  { ...activityTypes[4], start: 18, duration: 6 },
];

const times = Array.from({ length: 25 }, (_, index) => {
  const totalMinutes = 10 * 60 + index * 30;
  return `${String(Math.floor(totalMinutes / 60)).padStart(2, '0')}:${String(totalMinutes % 60).padStart(2, '0')}`;
});
---
<BaseLayout title="Schedule" description="View and export the Mini CCC agenda.">
  <div class="page-shell">
    <Header
      title="Make room for"
      titleAccent="good ideas."
    />
    <main>
      <section class="schedule-section section-pad">
        <div class="schedule-layout">
          <section class="schedule-view" aria-label="Read-only schedule">
            <div class="schedule-view__topline"><div><span class="schedule-status-dot"></span><span>READ-ONLY AGENDA</span></div><span>{defaultBlocks.length} BLOCKS / 24 SLOTS</span></div>
            <div class="schedule-calendar">
              <div class="schedule-times" aria-hidden="true">{times.slice(0, -1).map((time, index) => <span style={`--time-row: ${index + 1}`}>{time}</span>)}</div>
              <div class="schedule-grid" style="--slot-count: 24">
                {defaultBlocks.map((block) => <div class:list={['schedule-block', `accent-${block.accent}`]} data-schedule-block data-label={block.label} data-start={block.start} data-duration={block.duration} style={`--start: ${block.start}; --span: ${block.duration}`}>
                  <div class="schedule-block__body"><span class="schedule-block__time">{times[block.start]}—{times[block.start + block.duration]}</span><strong>{block.label}</strong></div>
                </div>)}
              </div>
            </div>
            <div class="schedule-view__actions"><button class="button button--primary" type="button" data-export-schedule>Export .txt <Download size={14} stroke-width={1.7} aria-hidden="true" focusable="false" /></button></div>
          </section>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
