---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { ArrowUpDown, Download, GripVertical, Save, X } from '@lucide/astro';

const palette = [
  { id: 'cocktails', label: 'Cocktail making', short: 'COCKTAILS', accent: 'orange' },
  { id: 'youtube', label: 'YouTube videos', short: 'YOUTUBE', accent: 'blue' },
  { id: 'lockpicking', label: 'Lock picking', short: 'LOCK PICKING', accent: 'pink' },
  { id: 'diy-one', label: 'DIY project 1', short: 'DIY 01', accent: 'lime' },
  { id: 'diy-two', label: 'DIY project 2', short: 'DIY 02', accent: 'lime' },
  { id: 'lunch', label: 'Lunch', short: 'LUNCH', accent: 'orange' },
  { id: 'dinner', label: 'Dinner', short: 'DINNER', accent: 'orange' },
];

const defaultBlocks = [
  { ...palette[0], start: 0, duration: 2 },
  { ...palette[1], start: 2, duration: 2 },
  { ...palette[5], start: 4, duration: 2 },
  { ...palette[3], start: 6, duration: 8 },
  { ...palette[2], start: 14, duration: 2 },
  { ...palette[6], start: 16, duration: 2 },
  { ...palette[4], start: 18, duration: 6 },
];

const times = Array.from({ length: 25 }, (_, index) => {
  const totalMinutes = 10 * 60 + index * 30;
  return `${String(Math.floor(totalMinutes / 60)).padStart(2, '0')}:${String(totalMinutes % 60).padStart(2, '0')}`;
});
---
<BaseLayout title="Schedule" description="Build a tiny, highly adjustable day for Mini CCC.">
  <div class="page-shell">
    <Header
      title="Make room for"
      titleAccent="good ideas."
    />
    <main>
      <section class="schedule-section section-pad">
        <div class="schedule-layout">
          <aside class="schedule-palette" aria-label="Available schedule blocks">
            <div class="schedule-panel-heading"><span>AVAILABLE BLOCKS</span><span>DRAG TO ADD</span></div>
            <div class="palette-list" data-schedule-tray>
              {palette.map((block) => <div class:list={['palette-block', `accent-${block.accent}`]} draggable="true" data-palette-block data-block-id={block.id} data-label={block.label}><span class="palette-block__dot"></span><span>{block.label}</span><span class="palette-block__grip" aria-hidden="true"><GripVertical size={14} stroke-width={1.7} focusable="false" /></span></div>)}
            </div>
            <div class="schedule-help"><span class="schedule-help__mark" aria-hidden="true"><ArrowUpDown size={17} stroke-width={1.6} focusable="false" /></span><p>Drop into the grid. Drag the lower edge to resize. Blocks stay on the half-hour and can never overlap.</p></div>
            <div class="schedule-palette__foot"><span>10:00—22:00 / LOCAL AGENDA</span><span>MAX 04:00</span></div>
          </aside>
          <section class="schedule-editor" aria-label="Editable schedule">
            <div class="schedule-editor__topline"><div><span class="schedule-status-dot"></span><span data-schedule-status>DEFAULT AGENDA</span></div><span>{defaultBlocks.length} BLOCKS / 24 SLOTS</span></div>
            <div class="schedule-calendar">
              <div class="schedule-times" aria-hidden="true">{times.slice(0, -1).map((time, index) => <span style={`--time-row: ${index + 1}`}>{time}</span>)}</div>
              <div class="schedule-grid" data-schedule-grid data-slot-count="24" style="--slot-count: 24">
                {defaultBlocks.map((block) => <div class:list={['schedule-block', `accent-${block.accent}`]} draggable="true" data-schedule-block data-block-id={block.id} data-label={block.label} data-start={block.start} data-duration={block.duration} style={`--start: ${block.start}; --span: ${block.duration}`}>
                  <span class="schedule-block__handle schedule-block__handle--top" data-resize="top" aria-hidden="true"></span>
                  <div class="schedule-block__body"><span class="schedule-block__time">{times[block.start]}—{times[block.start + block.duration]}</span><strong>{block.label}</strong></div>
                  <button type="button" class="schedule-block__remove" data-remove-schedule-block aria-label={`Remove ${block.label}`}><X size={14} stroke-width={1.8} aria-hidden="true" focusable="false" /></button>
                  <span class="schedule-block__handle schedule-block__handle--bottom" data-resize="bottom" aria-hidden="true"></span>
                </div>)}
                <div class="schedule-drop-hint" data-schedule-drop-hint>DROP A BLOCK<br /><span>ON A HALF-HOUR</span></div>
              </div>
            </div>
            <div class="schedule-editor__actions"><button class="button button--primary" type="button" data-save-schedule>Save agenda <Save size={14} stroke-width={1.7} aria-hidden="true" focusable="false" /></button><button class="button" type="button" data-export-schedule>Export .txt <Download size={14} stroke-width={1.7} aria-hidden="true" focusable="false" /></button><button class="text-button" type="button" data-reset-schedule>Reset default</button></div>
          </section>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
