---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CuratedCard from '../components/CuratedCard.astro';
import { cocktails } from '../data/content';
---
<BaseLayout title="Cocktails" description="A bright, caffeinated Club-Mate cocktail list for Mini CCC.">
  <div class="page-shell"><Header title="Things to" titleAccent="make and sip." /><main><section class="content-section section-pad"><div class="cocktail-filters" role="group" aria-label="Filter cocktails by alcohol content"><span class="cocktail-filters__label">SHOW</span><button class="filter-button is-active" type="button" data-cocktail-filter="all" aria-pressed="true">ALL</button><button class="filter-button" type="button" data-cocktail-filter="with-alcohol" aria-pressed="false">WITH ALCOHOL</button><button class="filter-button" type="button" data-cocktail-filter="without-alcohol" aria-pressed="false">WITHOUT ALCOHOL</button></div><div class="content-grid">{cocktails.map((item) => <CuratedCard item={item} type="cocktail" />)}</div><section class="ingredient-summary" data-ingredient-summary aria-labelledby="ingredient-summary-title"><div class="ingredient-summary__header"><div><span class="ingredient-summary__eyebrow">THE SHOPPING LIST</span><h2 id="ingredient-summary-title">What you’ll need.</h2><p data-ingredient-summary-count aria-live="polite">No cocktails selected yet.</p></div><div class="ingredient-summary__actions"><button class="ingredient-summary__action" type="button" data-select-all>SELECT ALL</button><button class="ingredient-summary__action" type="button" data-deselect-all>DESELECT ALL</button></div></div><div class="ingredient-summary__content" data-ingredient-summary-content><p class="ingredient-summary__empty">Choose cocktails above to build your ingredient list.</p></div></section></section></main></div>
</BaseLayout>
