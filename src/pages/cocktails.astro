---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CuratedCard from '../components/CuratedCard.astro';
import { cocktails } from '../data/content';
---
<BaseLayout title="Cocktails" description="A bright, caffeinated Club-Mate cocktail list for Mini CCC.">
  <div class="page-shell"><Header title="Things to" titleAccent="make and sip." /><main><section class="content-section section-pad"><div class="content-grid">{cocktails.map((item) => <CuratedCard item={item} type="cocktail" />)}</div></section></main></div>
</BaseLayout>
