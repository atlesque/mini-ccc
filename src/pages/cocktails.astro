---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BrandMark from '../components/BrandMark.astro';
import CuratedCard from '../components/CuratedCard.astro';
import { cocktails } from '../data/content';
---
<BaseLayout title="Cocktails" description="A bright, caffeinated Club-Mate cocktail list for Mini CCC.">
  <div class="page-shell"><Header title="Things to" titleAccent="make and sip." /><main><section class="content-section section-pad"><div class="content-grid">{cocktails.map((item) => <CuratedCard item={item} type="cocktail" />)}</div><div class="content-note"><span>PLEASE NOTE</span><p>Club-Mate contains caffeine. Enjoy the alcoholic serves responsibly, and keep plenty of water nearby.</p></div></section><footer class="site-footer section-pad"><div class="footer-brand"><BrandMark /><span>mini <strong>CCC</strong></span></div></footer></main></div>
</BaseLayout>
