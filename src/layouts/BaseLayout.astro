---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = 'Mini CCC — tiny builds, big signal',
  description = 'A miniature home hacker conference for friends, prototypes, and wonderfully unnecessary electronics.',
} = Astro.props;
const pageTitle = title === 'Mini CCC'
  ? 'Mini CCC — tiny builds, big signal'
  : title.includes('Mini CCC') ? title : `${title} — Mini CCC`;
const siteUrl = Astro.site ?? new URL('https://mini-ccc.pages.dev');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL('/generated/f29e14d7_000.png', siteUrl);
const imageAlt = 'A neon-lit electronics workshop with tiny DIY builds on the workbench.';
---
<!doctype html>
<html lang="en" data-theme="dark" data-theme-preference="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#101311" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Mini CCC" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="832" />
    <meta property="og:image:height" content="1248" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const stored = localStorage.getItem('mini-ccc-theme');
        const preference = stored === 'auto' || stored === 'light' || stored === 'dark' ? stored : 'auto';
        const theme = preference === 'auto'
          ? (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
          : preference;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = theme;
      } catch (error) {}
    </script>
  </head>
  <body>
    <div class="site-noise" aria-hidden="true"></div>
    <slot />
    <div class="toast" data-toast role="status" aria-live="polite" aria-atomic="true" hidden></div>
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
