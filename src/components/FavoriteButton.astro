---
import { Heart } from '@lucide/astro';

type Props = {
  projectId: string;
  projectName: string;
  compact?: boolean;
};

const { projectId, projectName, compact = false } = Astro.props;
---
<button
  class:list={['favorite-button', compact && 'favorite-button--compact']}
  type="button"
  data-favorite-button
  data-favorite-id={projectId}
  data-favorite-title={projectName}
  aria-label={`Favorite ${projectName}`}
  aria-pressed="false"
>
  <Heart class="favorite-symbol" size={18} stroke-width={1.7} aria-hidden="true" focusable="false" />
  <span data-favorite-label>Favorite</span>
</button>
