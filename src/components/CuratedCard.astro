---
import ProjectViz from './ProjectViz.astro';
import CocktailArt from './CocktailArt.astro';
import type { Cocktail, CuratedVideo } from '../data/content';
import { ExternalLink } from '@lucide/astro';

type Props = {
  item: Cocktail | CuratedVideo;
  type: 'cocktail' | 'video';
};

const { item, type } = Astro.props;
const isVideo = type === 'video';
---
<article class:list={['content-card', `content-card--${type}`]} data-cocktail-card={type === 'cocktail' ? '' : undefined} data-alcohol-free={type === 'cocktail' ? String((item as Cocktail).alcoholFree) : undefined} data-ingredients={type === 'cocktail' ? JSON.stringify((item as Cocktail).ingredients) : undefined}>
  <div class="content-card__visual">
    {isVideo && <img class="content-card__thumbnail" src={(item as CuratedVideo).thumbnail} alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" />}
    {isVideo ? <ProjectViz visual={item.visual} accent={item.accent} /> : <CocktailArt cocktail={item as Cocktail} />}
    <span class="content-card__number">{String(item.number).padStart(2, '0')}</span>
    {isVideo && <span class="content-card__type">WATCH LIST</span>}
  </div>
  <div class="content-card__copy">
    <div class="content-card__meta">
      {isVideo ? <><span>{(item as CuratedVideo).channel}</span><span>{(item as CuratedVideo).duration}</span></> : <span>{(item as Cocktail).alcoholFree ? 'NO ALCOHOL' : 'WITH ALCOHOL'} / {(item as Cocktail).style}</span>}
    </div>
    <h2>{isVideo ? (item as CuratedVideo).title : (item as Cocktail).name}</h2>
    <p>{item.summary}</p>
    {isVideo ? (
      <a class="content-card__link" href={(item as CuratedVideo).url} target="_blank" rel="noreferrer"><span>Open on YouTube</span><ExternalLink class="content-card__link-icon" size={16} stroke-width={1.7} aria-hidden="true" focusable="false" /></a>
    ) : (
      <div class="cocktail-details">
        <div><span>INGREDIENTS</span><p>{(item as Cocktail).ingredients.join(' · ')}</p></div>
        <div><span>METHOD</span><p>{(item as Cocktail).method}</p></div>
        <button class="cocktail-select" type="button" data-cocktail-select aria-pressed="false"><span class="cocktail-select__mark" aria-hidden="true"></span><span data-cocktail-select-label>Add to ingredient list</span></button>
      </div>
    )}
  </div>
</article>
