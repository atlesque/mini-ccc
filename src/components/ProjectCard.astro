---
import BuildArt from './BuildArt.astro';
import FavoriteButton from './FavoriteButton.astro';
import type { Project } from '../data/projects';
import { ArrowUpRight } from '@lucide/astro';

type Props = {
  project: Project;
};

const { project } = Astro.props;
const categoryLabels: Record<string, string> = {
  play: 'PLAY',
  glow: 'GLOW',
  signal: 'SIGNAL',
  sound: 'SOUND',
  sensor: 'SENSORS',
  interface: 'INTERFACE',
  badge: 'BADGE',
};
const categoryLabel = categoryLabels[project.kind] ?? project.kind.toUpperCase();
---
<article
  class="project-card"
  data-project-card
  data-project-id={project.slug}
  data-kind={project.kind}
  data-project-title={project.name}
  data-title={project.name.toLowerCase()}
  data-summary={project.summary.toLowerCase()}
>
  <a class="project-card__main" href={`/projects/${project.slug}`}>
    <div class="project-card__topline">
      <span class="project-tag">{categoryLabel}</span>
      <ArrowUpRight class="project-arrow" size={17} stroke-width={1.5} aria-hidden="true" focusable="false" />
    </div>
    <BuildArt project={project} />
    <div class="project-card__copy">
      <h3>{project.name}</h3>
      <p>{project.summary}</p>
    </div>
  </a>
  <div class="project-card__footer">
    <span class="project-cost">€{project.total.toFixed(2)} <small>/ build</small></span>
    <FavoriteButton projectId={project.slug} projectName={project.name} compact />
  </div>
</article>
