---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProjectViz from './ProjectViz.astro';
import type { Cocktail } from '../data/content';

type Props = {
  cocktail: Pick<Cocktail, 'name' | 'visual' | 'accent'>;
};

const { cocktail } = Astro.props;
const slug = cocktail.name.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const images = import.meta.glob<ImageMetadata>('../assets/cocktails/*.webp', { eager: true, import: 'default' });
const image = images[`../assets/cocktails/${slug}.webp`];
---
<div class:list={['content-card__art', image && 'content-card__art--loading']}>
  {!image && <ProjectViz visual={cocktail.visual} accent={cocktail.accent} />}
  {image && (
    <Picture
      class="content-card__art-image"
      src={image}
      alt={`${cocktail.name} cocktail illustration`}
      formats={['avif', 'webp']}
      widths={[320, 480, 640, 800]}
      sizes="(max-width: 760px) calc(100vw - 88px), (max-width: 1100px) calc(48vw - 60px), 390px"
      quality={75}
      loading="lazy"
      decoding="async"
    />
  )}
</div>
