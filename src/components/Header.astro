---
import BrandMark from './BrandMark.astro';
import { Moon, Sun, SunMoon } from '@lucide/astro';

type Props = {
  title?: string;
  titleAccent?: string;
  variant?: 'home' | 'standard' | 'detail';
  accent?: 'lime' | 'blue' | 'orange' | 'pink';
};

const {
  title,
  titleAccent,
  variant = 'standard',
  accent = 'lime',
} = Astro.props;

const currentPath = Astro.url.pathname;
const links = [
  { href: '/schedule', label: 'Schedule' },
  { href: '/builds', label: 'Builds' },
  { href: '/cocktails', label: 'Cocktails' },
  { href: '/videos', label: 'Videos' },
];
---
<header class:list={['site-header', `site-header--${variant}`, `accent-${accent}`]}>
  <div class="site-header__bar">
    <a class="brand" href="/" aria-label="Mini CCC home">
      <BrandMark />
      <span>mini <strong>CCC</strong></span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {links.map((link) => (
        <a href={link.href} class:list={{ 'is-active': currentPath === link.href }} aria-current={currentPath === link.href ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Theme: automatic. Switch to light mode">
        <span class="theme-icon theme-icon--auto" aria-hidden="true">
          <SunMoon size={21} stroke-width={1.5} focusable="false" />
        </span>
        <span class="theme-icon theme-icon--sun" aria-hidden="true">
          <Sun size={21} stroke-width={1.5} focusable="false" />
        </span>
        <span class="theme-icon theme-icon--moon" aria-hidden="true">
          <Moon size={21} stroke-width={1.5} focusable="false" />
        </span>
      </button>
    </div>
  </div>

  {title && (
    <div class:list={['page-header', `page-header--${variant}`, 'section-pad']}>
      <div class="page-header__inner">
        <div class="page-header__content">
          <div class="page-header__body">
            <div class="page-header__title-row">
              <h1>{title}{titleAccent && <><br /><span class="page-header__title-accent">{titleAccent}</span></>}</h1>
            </div>
            <div class="page-header__actions"><slot name="actions" /></div>
          </div>
        </div>
        <div class="page-header__media"><slot name="media" /></div>
      </div>
    </div>
  )}
</header>
