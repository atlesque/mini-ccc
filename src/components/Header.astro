---
import BrandMark from './BrandMark.astro';

const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'Schedule' },
  { href: '/builds', label: 'Builds' },
  { href: '/cocktails', label: 'Cocktails' },
  { href: '/videos', label: 'Videos' },
];
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Mini CCC home">
    <BrandMark />
    <span>mini <strong>CCC</strong></span>
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    {links.map((link) => (
      <a href={link.href} class:list={{ 'is-active': currentPath === link.href }} aria-current={currentPath === link.href ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="header-actions">
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Theme: automatic. Switch to light mode">
      <span class="theme-icon theme-icon--auto" aria-hidden="true">
        <svg viewBox="0 0 20 20" focusable="false"><circle cx="10" cy="10" r="7.2" /><path d="M10 2.8a7.2 7.2 0 0 1 0 14.4Z" /></svg>
      </span>
      <span class="theme-icon theme-icon--sun" aria-hidden="true">
        <svg viewBox="0 0 20 20" focusable="false"><circle cx="10" cy="10" r="3.6" /><path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M16 4l-1.4 1.4M5.4 14.6 4 16" /></svg>
      </span>
      <span class="theme-icon theme-icon--moon" aria-hidden="true">
        <svg viewBox="0 0 20 20" focusable="false"><path d="M14.6 3.1a7.5 7.5 0 1 0 2.3 13.1A7 7 0 0 1 14.6 3.1Z" /></svg>
      </span>
    </button>
  </div>
</header>
